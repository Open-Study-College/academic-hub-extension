{
  "name": "academic-hub-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx app/db/seed.ts",
    "db:reset": "tsx app/db/reset.ts && drizzle-kit push && tsx app/db/seed.ts"
  },
  "dependencies": {
    "@react-router/node": "^7.13.2",
    "@react-router/serve": "^7.13.2",
    "@tanstack/react-query": "^5.100.11",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "better-sqlite3": "^12.4.1",
    "dayjs": "^1.11.19",
    "drizzle-orm": "^0.44.2",
    "isbot": "^5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.13.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-router/dev": "^7.13.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.2"
  }
}
